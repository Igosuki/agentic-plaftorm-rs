# HS256 signing secret, at least 32 bytes. Generate with: openssl rand -hex 32
# `make env` fills this in when it creates .env.
PLATFORM_JWT_SECRET=
# Agent engine: rig (default) or adk (needs CARGO_FEATURES=adk at build time).
# AGENT_ENGINE=adk
# CARGO_FEATURES=adk
DEFAULT_MODEL=ollama:gpt-oss
COORDINATOR_MODEL=ollama:gpt-oss

# DEFAULT_MODEL=openai:gpt-4.1-mini
# COORDINATOR_MODEL=openai:gpt-4.1-mini
# DEFAULT_MODEL=anthropic:claude-sonnet-5-5
# COORDINATOR_MODEL=anthropic:claude-sonnet-5-5

# Use http://ollama:11434 with `docker compose --profile ollama up`
OLLAMA_API_BASE_URL=http://host.docker.internal:11434

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# AI gateway (deploy/llm-gateway): DEFAULT_MODEL=gateway:default sends calls through it.
# `make env` fills in LITELLM_MASTER_KEY; keep it out of platform instances and use virtual keys there.
LITELLM_MASTER_KEY=
LLM_GATEWAY_URL=http://localhost:4000
# A LiteLLM virtual key, or the master key for local development (defaults to LITELLM_MASTER_KEY where unset).
LLM_GATEWAY_API_KEY=
# Optional per-team virtual keys: also add `team_keys: {docs-team: LLM_GATEWAY_KEY_DOCS_TEAM}` under llm_gateway in platform.yaml.
# LLM_GATEWAY_KEY_DOCS_TEAM=
# DEFAULT_MODEL=gateway:default
# COORDINATOR_MODEL=gateway:default

RUST_LOG=info
